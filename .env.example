###############################################################################
# Product Description Microservice — Environment Variables
# Copy this file to .env.local and fill in the values.
###############################################################################

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_to_a_random_string
###< symfony/framework-bundle ###

###> redis ###
REDIS_URL=redis://localhost:6379
###< redis ###

###> symfony/messenger ###
# Transport: Redis (default) or AMQP (RabbitMQ)
# Docker Compose: Set COMPOSE_PROFILES=rabbitmq to automatically spin up RabbitMQ container
# COMPOSE_PROFILES=rabbitmq

MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN_FAILED=redis://localhost:6379/failed_messages

# RabbitMQ (AMQP) alternative:
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN_FAILED=amqp://guest:guest@localhost:5672/%2f/failed_messages
###< symfony/messenger ###

###> ai configuration ###

# AI Provider: 'ollama' (local, self-hosted) or 'gemini' (Google Cloud API)
AI_PROVIDER=ollama

# --- Ollama (Local LLM) ---
OLLAMA_URL=http://127.0.0.1:21434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TEMPERATURE=0.7

# --- Google Gemini (Cloud LLM) ---
# Get your API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/interactions

# --- Prompt Template ---
# Available placeholders: {name}, {features}
AI_PROMPT_TEMPLATE="Jesteś copywriterem e-commerce. Napisz krótki i atrakcyjny opis produktu po polsku:\nNazwa: {name}\nCechy: {features}"

###< ai configuration ###
